# The Node.js release the Sultana app ships to run its bridge, and the SHA-256
# of its macOS arm64 tarball from https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt.
# fetch-node.sh downloads and verifies it. To move to a newer release, change
# both lines (the checksum from that release's SHASUMS256.txt).
NODE_VERSION=24.22.1
NODE_SHA256=654ba79de6155647e22321932b45f2a1ccb705976cc337c9b8e278beb085a628
